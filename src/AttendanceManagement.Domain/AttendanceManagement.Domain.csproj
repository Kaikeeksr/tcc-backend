<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Esta camada nao tem NENHUM PackageReference e NENHUM ProjectReference.
    E de proposito: o dominio nao conhece EF Core, ASP.NET, banco ou HTTP.
    Se um dia algum pacote aparecer aqui, o desacoplamento foi quebrado.
    TargetFramework, Nullable e ImplicitUsings vem do Directory.Build.props na raiz.
  -->

  <PropertyGroup>
    <!-- CA1716: "Error" colide com palavra reservada em outras linguagens (VB, etc.).
         E o nome de dominio do padrao Result<T>/Error usado em todo o projeto;
         renomear custaria mais do que vale. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

</Project>
